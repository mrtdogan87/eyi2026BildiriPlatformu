# npm run local:setup creates fresh credentials. Never copy ../.env.
APP_ENV=local
DATABASE_URL=postgresql://aibildiri_v2:replace-with-local-password@127.0.0.1:55432/aibildiri_v2
DIRECT_URL=postgresql://aibildiri_v2:replace-with-local-password@127.0.0.1:55432/aibildiri_v2
APP_BASE_URL=http://127.0.0.1:3100
SESSION_COOKIE_NAMESPACE=aibildiri_v2_local
DRAFT_SESSION_SECRET=replace-with-new-random-secret-at-least-32-chars
ADMIN_SESSION_SECRET=replace-with-another-random-secret-at-least-32-chars
ADMIN_PASSWORD=replace-with-new-local-admin-password
FILE_STORAGE=database
MAIL_MODE=capture
MAIL_CAPTURE_DIR=.local/mail
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
