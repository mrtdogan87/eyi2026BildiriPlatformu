type Db=Prisma.TransactionClient;
export function programSubject(db:Db,cid:string,input:{sessionId:string;kind:string;contextKey:string;email:string}):Promise<{valid:boolean;reasons:string[];fingerprint:string;snapshot:Record<string,unknown>|null;session:Prisma.ProgramSessionGetPayload<{include:{room:true;talks:{include:{presenter:true;submission:{include:{authors:true}}}};duties:{include:{person:true}}}}> | null}>;
