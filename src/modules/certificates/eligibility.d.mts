import type {Prisma} from '@prisma/client';
import type {RecipientData} from './core';
export type Selection={email:string;role:string;sessionId?:string;talkId?:string;dutyId?:string;submissionId?:string;registrationId?:string;recipientName?:string;institution?:string};
export const defaultRule:{enabled:boolean;paymentRequired:boolean;attendanceRequired:boolean};
export function eligibilitySourceId(selection:Selection):string;
export function fingerprint(value:unknown):string;
