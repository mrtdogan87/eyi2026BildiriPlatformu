generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum SubmissionLanguage {
  TR
  EN
}

enum PresentationMode {
  ONLINE
  IN_PERSON
}

enum PaymentPeriod {
  EARLY
  LATE
}

enum AudienceType {
  ACADEMIC
  STUDENT
}

enum AttendeeRole {
  PRESENTER
  LISTENER
}

enum RegistrationKind {
  PAPERS
  LISTENER
}

model Congress {
  emailSettings            EmailSettings?
  emailTemplates           EmailTemplate[]
  emailMessages            EmailMessage[]
  emailDeliveryIssues      EmailDeliveryIssue[]
  siteRecords              SiteRecord[]
  feedbackRequests         FeedbackRequest[]
  cmsAliases               CmsPageAlias[]
  cmsPages                 CmsPage[]
  cmsMedia                 CmsMedia[]
  siteConfiguration        Json?
  siteVersion              Int                       @default(0)
  siteAssets               SiteAsset[]
  year                     Int?
  eventStartsAt            DateTime?
  eventEndsAt              DateTime?
  configuration            Json?
  configVersion            Int                       @default(0)
  deliveryExceptions       DeliveryException[]
  organizationId           String
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships              CongressMembership[]
  modules                  CongressModule[]
  sessions                 PlatformSession[]
  audits                   AuditLog[]
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  name                     String
  earlyDeadline            DateTime?
  lateDeadline             DateTime?
  galaFeeAmount            Int                       @default(0)
  galaFeeCurrency          String                    @default("EUR")
  galaFeeNote              String?
  bankName                 String?
  bankAccountHolder        String?
  bankIban                 String?
  bankBranch               String?
  tripNote                 String?
  // Admin panelinden çevrilen anahtar: açıkken yeni bildiri gönderimi tamamen durur.
  submissionsClosed        Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  submissions              Submission[]
  paymentTiers             PaymentTier[]
  registrations            Registration[]
  registrationAccessTokens RegistrationAccessToken[]

  @@index([organizationId])
}

model PaymentTier {
  id               String                  @id @default(cuid())
  congressId       String
  presentationMode PresentationMode?
  role             AttendeeRole
  audience         AudienceType?
  paperOrder       Int?
  period           PaymentPeriod?
  amount           Int                     @default(0)
  currency         String                  @default("TRY")
  active           Boolean                 @default(true)
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  congress         Congress                @relation(fields: [congressId], references: [id], onDelete: Cascade)
  paperItems       RegistrationPaperItem[]

  @@unique([congressId, presentationMode, role, audience, paperOrder, period])
  @@index([congressId, active])
}

model Submission {
  deliveryExceptions DeliveryException[]
  id                 String                    @id @default(cuid())
  congressId         String
  status             SubmissionStatus          @default(DRAFT)
  submissionLanguage SubmissionLanguage?
  titleTr            String?
  titleEn            String?
  abstractTr         String?
  abstractEn         String?
  keywordsTr         String?
  keywordsEn         String?
  presentationMode   PresentationMode?
  audience           AudienceType?
  draftOwnerEmail    String
  submittedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  congress           Congress                  @relation(fields: [congressId], references: [id], onDelete: Cascade)
  authors            SubmissionAuthor[]
  file               SubmissionFile?
  accessTokens       SubmissionAccessToken[]
  statusHistory      SubmissionStatusHistory[]
  paperItem          RegistrationPaperItem?

  @@index([congressId, status])
  @@index([draftOwnerEmail])
}

model SubmissionAuthor {
  id           String     @id @default(cuid())
  submissionId String
  fullName     String
  title        String?
  email        String
  institution  String?
  country      String?
  isPresenter  Boolean    @default(false)
  sortOrder    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, email])
  @@index([submissionId])
  @@index([email])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String     @unique
  originalName String
  mimeType     String
  fileSize     Int
  storageKey   String
  content      Bytes?
  uploadedAt   DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SubmissionAccessToken {
  id           String     @id @default(cuid())
  submissionId String
  email        String
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([email])
  @@index([expiresAt])
}

model SubmissionStatusHistory {
  id           String            @id @default(cuid())
  submissionId String
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus
  note         String?
  changedAt    DateTime          @default(now())
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, changedAt])
}

model Registration {
  id                       String                       @id @default(cuid())
  congressId               String
  email                    String
  kind                     RegistrationKind
  audience                 AudienceType?
  listenerPresentationMode PresentationMode?
  listenerDayOne           Boolean                      @default(true)
  listenerDayTwo           Boolean                      @default(false)
  galaAttendance           Boolean                      @default(false)
  galaAttendeeCount        Int                          @default(0)
  galaFeeAmount            Int?
  galaFeeCurrency          String?
  tripAttendance           Boolean                      @default(false)
  tripAttendeeCount        Int                          @default(0)
  paymentPeriod            PaymentPeriod
  totalAmount              Int
  currency                 String                       @default("TRY")
  paymentDescription       String
  paidAt                   DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  congress                 Congress                     @relation(fields: [congressId], references: [id], onDelete: Cascade)
  receipt                  RegistrationReceipt?
  studentDocument          RegistrationStudentDocument?
  paperItems               RegistrationPaperItem[]

  @@index([congressId, email])
  @@index([email])
}

model RegistrationPaperItem {
  id             String       @id @default(cuid())
  registrationId String
  submissionId   String       @unique
  paperOrder     Int
  amount         Int
  currency       String
  tierId         String?
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tier           PaymentTier? @relation(fields: [tierId], references: [id])

  @@index([registrationId])
}

model RegistrationReceipt {
  id             String       @id @default(cuid())
  registrationId String       @unique
  originalName   String
  mimeType       String
  fileSize       Int
  storageKey     String
  content        Bytes?
  uploadedAt     DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model RegistrationStudentDocument {
  id             String       @id @default(cuid())
  registrationId String       @unique
  originalName   String
  mimeType       String
  fileSize       Int
  storageKey     String
  content        Bytes?
  uploadedAt     DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model RegistrationAccessToken {
  id         String    @id @default(cuid())
  congressId String
  email      String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  congress   Congress  @relation(fields: [congressId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
}

enum CongressRole {
  ORGANIZER
  SECRETARY
  CONTENT_EDITOR
  REVIEWER
  SESSION_CHAIR
  PARTICIPANT
}

enum ModuleKey {
  SUBMISSIONS
  REGISTRATION
  CMS
  REVIEWS
  PROGRAM
  CERTIFICATES
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  createdAt   DateTime                 @default(now())
  congresses  Congress[]
  memberships OrganizationMembership[]
  audits      AuditLog[]
}

model PlatformUser {
  emailDeliveryIssues EmailDeliveryIssue[]
  cmsRevisions        CmsRevision[]
  cmsMedia            CmsMedia[]
  id                  String                   @id @default(cuid())
  email               String                   @unique
  name                String
  passwordHash        String?
  platformAdmin       Boolean                  @default(false)
  active              Boolean                  @default(true)
  failedLogins        Int                      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organizations       OrganizationMembership[]
  congresses          CongressMembership[]
  sessions            PlatformSession[]
  deliveryExceptions  DeliveryException[]
  activationTokens    ActivationToken[]
  audits              AuditLog[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  organizer      Boolean      @default(false)
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model CongressMembership {
  id         String       @id @default(cuid())
  congressId String
  userId     String
  role       CongressRole
  active     Boolean      @default(true)
  congress   Congress     @relation(fields: [congressId], references: [id], onDelete: Cascade)
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([congressId, userId])
  @@index([userId])
}

model CongressModule {
  id         String    @id @default(cuid())
  congressId String
  key        ModuleKey
  enabled    Boolean   @default(false)
  congress   Congress  @relation(fields: [congressId], references: [id], onDelete: Cascade)

  @@unique([congressId, key])
}

model PlatformSession {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  congressId String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  congress   Congress?    @relation(fields: [congressId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ActivationToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  congressId     String?
  action         String
  targetId       String?
  detail         Json?
  createdAt      DateTime      @default(now())
  actor          PlatformUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  congress       Congress?     @relation(fields: [congressId], references: [id], onDelete: Restrict)

  @@index([congressId, createdAt])
}

enum DeliveryStage {
  ABSTRACT
  FULL_TEXT
}

model DeliveryException {
  id           String        @id @default(cuid())
  congressId   String
  email        String
  submissionId String?
  stage        DeliveryStage
  reason       String
  startsAt     DateTime      @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime      @default(now())
  congress     Congress      @relation(fields: [congressId], references: [id], onDelete: Cascade)
  submission   Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy    PlatformUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([congressId, email, stage, expiresAt])
}

enum SiteAssetKind {
  LOGO
  HERO
}

model SiteAsset {
  id           String        @id @default(cuid())
  congressId   String
  kind         SiteAssetKind
  originalName String
  mimeType     String
  content      Bytes
  width        Int
  height       Int
  active       Boolean       @default(true)
  updatedAt    DateTime      @updatedAt
  congress     Congress      @relation(fields: [congressId], references: [id], onDelete: Cascade)

  @@unique([congressId, kind])
}

enum CmsRevisionKind {
  SAVE
  PUBLISH
  RESTORE
  WITHDRAW
}

enum CmsMediaKind {
  IMAGE
  PDF
  WORD_TEMPLATE
}

model CmsPage {
  archived            Boolean        @default(false)
  templateKey         String?
  aliases             CmsPageAlias[]
  id                  String         @id @default(cuid())
  congressId          String
  slug                String
  internalName        String
  draft               Json
  version             Int            @default(1)
  publishedRevisionId String?        @unique
  publishedRevision   CmsRevision?   @relation("CmsPublication", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions           CmsRevision[]  @relation("CmsHistory")
  congress            Congress       @relation(fields: [congressId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([congressId, slug])
  @@unique([congressId, templateKey])
}

model CmsRevision {
  id          String             @id @default(cuid())
  pageId      String
  number      Int
  kind        CmsRevisionKind
  content     Json
  createdById String?
  createdBy   PlatformUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  page        CmsPage            @relation("CmsHistory", fields: [pageId], references: [id], onDelete: Cascade)
  publishedBy CmsPage?           @relation("CmsPublication")
  mediaRefs   CmsRevisionMedia[]

  @@unique([pageId, number])
}

model CmsMedia {
  siteReferences SiteRecordMedia[]
  id             String             @id @default(cuid())
  congressId     String
  internalName   String
  originalName   String
  kind           CmsMediaKind
  mimeType       String
  content        Bytes
  width          Int?
  height         Int?
  byteSize       Int
  active         Boolean            @default(true)
  version        Int                @default(1)
  uploadedById   String?
  uploadedBy     PlatformUser?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  congress       Congress           @relation(fields: [congressId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  references     CmsRevisionMedia[]

  @@index([congressId, createdAt])
}

model CmsRevisionMedia {
  revisionId String
  mediaId    String
  revision   CmsRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      CmsMedia    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([revisionId, mediaId])
}

model CmsPageAlias {
  id         String   @id @default(cuid())
  congressId String
  slug       String
  pageId     String
  congress   Congress @relation(fields: [congressId], references: [id], onDelete: Cascade)
  page       CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([congressId, slug])
  @@index([pageId])
}

enum SiteRecordKind {
  PERSON
  ORGANIZATION
  COMMITTEE
  TASK
  SPEAKER
  PANEL
  VENUE
  HOTEL
  TRANSFER
  TRIP
  SPONSOR
  ANNOUNCEMENT
  NEWS
  EVENT
  GALLERY
}

model SiteRecord {
  id               String               @id @default(cuid())
  congressId       String
  congress         Congress             @relation(fields: [congressId], references: [id], onDelete: Cascade)
  kind             SiteRecordKind
  internalName     String
  draft            Json
  published        Json?
  publishedVersion Int?
  version          Int                  @default(1)
  archived         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  revisions        SiteRecordRevision[]

  @@index([congressId, kind, archived])
}

model SiteRecordRevision {
  id        String            @id @default(cuid())
  recordId  String
  record    SiteRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  number    Int
  kind      CmsRevisionKind
  content   Json
  actorId   String?
  createdAt DateTime          @default(now())
  mediaRefs SiteRecordMedia[]

  @@unique([recordId, number])
}

model SiteRecordMedia {
  revisionId String
  revision   SiteRecordRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  mediaId    String
  media      CmsMedia           @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([revisionId, mediaId])
}

model FeedbackRequest {
  id            String   @id @default(cuid())
  congressId    String
  congress      Congress @relation(fields: [congressId], references: [id], onDelete: Cascade)
  requestKey    String
  payloadHash   String
  senderName    String
  email         String
  subject       String
  message       String
  noticeVersion String
  locale        String
  status        String   @default("NEW")
  version       Int      @default(1)
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([congressId, requestKey])
  @@index([congressId, status, createdAt])
  @@index([congressId, email, createdAt])
}

enum EmailMessageStatus {
  PENDING
  PROCESSING
  RETRY
  CAPTURED
  ACCEPTED
  PERMANENT_FAILURE
  UNKNOWN
  CANCELLED
}

enum EmailIssueStatus {
  OPEN
  RESOLVED
}

model EmailSettings {
  congressId String   @id
  congress   Congress @relation(fields: [congressId], references: [id], onDelete: Cascade)
  replyTo    String?
  replyUrl   String?
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model EmailTemplate {
  id         String   @id @default(cuid())
  congressId String
  congress   Congress @relation(fields: [congressId], references: [id], onDelete: Cascade)
  key        String
  locale     String
  subject    String
  body       String
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([congressId, key, locale])
}

model EmailMessage {
  id              String              @id @default(uuid())
  congressId      String
  congress        Congress            @relation(fields: [congressId], references: [id], onDelete: Restrict)
  dedupeKey       String
  payloadHash     String
  module          ModuleKey?
  templateKey     String
  templateVersion Int
  locale          String
  recipient       String
  subject         String
  text            String
  html            String
  replyTo         String?
  sourceType      String?
  sourceId        String?
  expiresAt       DateTime?
  status          EmailMessageStatus  @default(PENDING)
  version         Int                 @default(1)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime            @default(now())
  lastAttemptAt   DateTime?
  leaseToken      String?
  leaseUntil      DateTime?
  provider        String?
  providerId      String?
  acceptedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  history         EmailAttempt[]
  deliveryIssue   EmailDeliveryIssue?

  @@unique([congressId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([congressId, createdAt])
  @@index([congressId, sourceType, sourceId])
}

// Append-only delivery audit. No credentials, access links or raw provider responses.
model EmailAttempt {
  id           String       @id @default(cuid())
  messageId    String
  message      EmailMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  number       Int
  provider     String
  outcome      String
  errorCode    String?
  errorSummary String?
  startedAt    DateTime
  finishedAt   DateTime     @default(now())

  @@unique([messageId, number])
}

model EmailDeliveryIssue {
  id          String           @id @default(cuid())
  congressId  String
  congress    Congress         @relation(fields: [congressId], references: [id], onDelete: Restrict)
  messageId   String           @unique
  message     EmailMessage     @relation(fields: [messageId], references: [id], onDelete: Restrict)
  status      EmailIssueStatus @default(OPEN)
  version     Int              @default(1)
  note        String           @default("")
  resolution  String?
  updatedById String?
  updatedBy   PlatformUser?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  @@index([congressId, status, createdAt])
}
