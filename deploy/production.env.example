# Copy to a protected location outside the Git checkout (chmod 600).
# Supply through Coolify runtime variables or docker compose --env-file.
# No existing EYI database, password, volume or application is reused.
# Fresh random hexadecimal values are URI-safe (e.g. 32 random bytes as hex).
# Compose derives DATABASE_URL/DIRECT_URL from this one DB password.
V2_PRODUCTION_DB_PASSWORD=replace-with-fresh-random-hex-db-password
DRAFT_SESSION_SECRET=replace-with-fresh-random-secret-at-least-32-chars

# Enable only for the authorized live deployment with a working mail account.
EMAIL_DELIVERY_ENABLED=true
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Stativera Kongre

# When using Resend instead, set MAIL_PROVIDER=resend and fill these values.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Stativera Kongre

# The domain, namespace, DB/user name and private DB host are fixed in Compose:
# APP_BASE_URL=https://kongre.stativera.store
# SESSION_COOKIE_NAMESPACE=aibildiri_v2_production
# V2_DB_HOST=db-v2-production
# Migration/bootstrap confirmations are deliberately absent. Pass them only
# with `docker compose run -e ...` for the explicitly approved one-off job.
# Bootstrap identity/passwordHash arrive on stdin, never as env or build args.
