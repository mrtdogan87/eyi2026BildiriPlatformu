# Generate fresh credentials for a separate v2 test application. Do not reuse live env.
# example.invalid is a placeholder; the test subdomain has not been selected.
APP_ENV=preview
APP_BASE_URL=https://v2-preview.example.invalid
V2_DB_HOST=db-v2-preview
V2_PREVIEW_DB_PASSWORD=replace-with-new-db-password
DATABASE_URL=postgresql://aibildiri_v2_preview:replace-with-new-db-password@db-v2-preview:5432/aibildiri_v2_preview
DIRECT_URL=postgresql://aibildiri_v2_preview:replace-with-new-db-password@db-v2-preview:5432/aibildiri_v2_preview
SESSION_COOKIE_NAMESPACE=aibildiri_v2_preview
DRAFT_SESSION_SECRET=replace-with-new-random-secret-at-least-32-chars
ADMIN_SESSION_SECRET=replace-with-another-random-secret-at-least-32-chars
ADMIN_PASSWORD=replace-with-new-admin-password
PREVIEW_ACCESS_USER=v2-tester
PREVIEW_ACCESS_PASSWORD=replace-with-new-preview-password
FILE_STORAGE=database
MAIL_MODE=capture
MAIL_CAPTURE_DIR=/app/.preview/mail
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
